# Populate these values in AWS Secrets Manager or GitHub Environments.
# Never commit real values.
TF_VAR_os_db_password=replace-with-a-random-secret
TF_VAR_billing_db_password=replace-with-a-random-secret
TF_VAR_execution_db_password=replace-with-a-random-secret

