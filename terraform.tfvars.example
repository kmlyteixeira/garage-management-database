project_name        = "garage-management"
environment          = "development"
region               = "us-east-1"
vpc_id               = "vpc-xxxxxxxx"
private_subnet_ids   = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
api_security_group_id = "sg-xxxxxxxx"
db_instance_class    = "db.t3.micro"
db_name              = "GarageManagement"
db_username          = "garage_user"
multi_az             = false
backup_retention_period = 7
delection_protection = true

# Never commit the password. Supply TF_VAR_db_password or a CI secret.
